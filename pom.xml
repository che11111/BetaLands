<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.che1s</groupId>
    <artifactId>BetaLands</artifactId>
    <version>1.1.7</version>
    <packaging>jar</packaging>

    <name>BetaLands</name>
    <description>2D and 3D land protection for Minecraft Beta 1.7.3 Project Poseidon</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>poseidon</id>
            <url>https://repository.johnymuffin.com/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>legacy.local</groupId>
            <artifactId>poseidon-craftbukkit</artifactId>
            <version>1.1.12</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/poseidon-craftbukkit-1.1.12.jar</systemPath>
        </dependency>

        <!-- Optional runtime integrations. These are compiled against the bundled legacy jars. -->
        <dependency>
            <groupId>legacy.local</groupId>
            <artifactId>Towny</artifactId>
            <version>0.76.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Towny_0.76.0_CB1092.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.local</groupId>
            <artifactId>dynmap</artifactId>
            <version>0.24</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/dynmap.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.local</groupId>
            <artifactId>BlueMap</artifactId>
            <version>dev-poseidon</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/BlueMap-dev-poseidon.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>legacy.local</groupId>
            <artifactId>iConomy</artifactId>
            <version>5.01</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/iConomy.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.36.0.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>5.1.49</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-base</artifactId>
            <version>3.2.1</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>BetaLands-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>BetaLands</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.bstats:bstats-base</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>dev.che1s.betalands.libs.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
